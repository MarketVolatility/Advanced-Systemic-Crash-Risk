import {requiredValue} from '../src/core/defined.ts';
import './check-strict-policy.mts';
import {checkBuildContracts} from './check-build-contracts.mts';
import { readFile, writeFile } from 'node:fs/promises';
import { build, transform } from 'esbuild';
import vm from 'node:vm';
const read = (path:string) => readFile(path,'utf8');
const core = await build({entryPoints:['src/core/index.ts'],bundle:true,write:false,format:'iife',globalName:'DashboardCore',target:'es2022',minify:false,legalComments:'none'});
const escapeScript = (code:string) => code.replace(/<\/script/gi,'<\\/script');
const script = (code:string) => '<script>\n'+escapeScript(code)+'\n</script>';
let html = await read('src/index.template.html');
html = html.replace('<!-- BUILD:CORE -->',script(requiredValue(core.outputFiles[0]).text));
const styles = (await read('src/styles/base.css'))+'\n'+await read('src/styles/design.css')+'\n'+await read('src/styles/workspace.css')+'\n'+await read('src/styles/account-layout.css')+'\n'+await read('src/styles/theme.css');
html = html.replace('<!-- BUILD:STYLES -->','<style>\n'+styles+'\n</style>');
for (const [marker,file] of [['PLATFORM','platform'],['TABLES','table-controls'],['DISCLOSURES','disclosures']]) {
  html=html.replace(`<!-- BUILD:${marker} -->`,script((await transform(await read('src/runtime/'+file+'.ts'),{loader:'ts',target:'es2022'})).code));
}
const fileList:unknown=JSON.parse(await read('src/runtime/load-order.json'));
if(!Array.isArray(fileList)||!fileList.every((value:unknown):value is string=>typeof value==='string'))throw Error('Runtime load order must contain only source paths.');
const files:string[]=fileList;
if(files.some(file=>!file.endsWith('.ts')))throw Error('Runtime sources must be TypeScript.');
let app=(await Promise.all(files.map(async file=>{
  const source=(await read(file)).replace(/\/\* BUILD:DATA:(\w+) \*\//g,(_match:string,name:string)=>`const ${name} = __BUILD_DATA_${name}__;`);
  return file.endsWith('.ts')?(await transform(source,{loader:'ts',target:'es2022'})).code:source;
}))).join('\n');
const datasets=new Map<string,unknown>();
for (const match of [...app.matchAll(/__BUILD_DATA_(\w+)__/g)]) {
  const raw=await read('src/data/'+match[1]+'.json');
  const data:unknown=JSON.parse(raw);
  datasets.set(requiredValue(match[1]),data);
  app=app.replace(match[0],JSON.stringify(data));
}
checkBuildContracts(await read('src/index.template.html'),datasets);
html=html.replace('<!-- BUILD:APP -->',script(app));
if (/<!-- BUILD:/.test(html)) throw Error('Unresolved build placeholder');
for(const m of html.matchAll(/<script(?:\s[^>]*)?>([\s\S]*?)<\/script>/g)) new vm.Script(requiredValue(m[1]));
// Dynamic HTML templates contain their own IDs; static template IDs must be unique.
const staticIds=[...(await read('src/index.template.html')).matchAll(/\bid="([^"]+)"/g)].map(m=>m[1]);
if(new Set(staticIds).size!==staticIds.length) throw Error('Duplicate static HTML IDs');
html=html.replace('<!DOCTYPE html>','<!DOCTYPE html>\n<!-- Generated by npm run build. Edit src/, not this file. -->');
await writeFile('index.html',html);
console.log(`Built index.html (${(Buffer.byteLength(html)/1024/1024).toFixed(2)} MB), self-contained apart from existing Supabase SDK.`);
